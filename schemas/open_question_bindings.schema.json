{
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "owner_note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "slot_anchor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "owner_note",
          "slot_anchor",
          "anchor"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "questions"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "open_question_bindings"
}
