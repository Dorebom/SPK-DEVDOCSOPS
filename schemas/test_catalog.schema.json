{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "condition": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "NOT_RUN",
              "PASS",
              "FAIL",
              "NOT_APPLICABLE",
              "INCONCLUSIVE"
            ]
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "acceptance_profile": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "system_requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "origin",
          "condition",
          "expected",
          "status",
          "source_id",
          "acceptance_profile",
          "system_requirement_ids"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema",
    "tests"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "test_catalog"
}
