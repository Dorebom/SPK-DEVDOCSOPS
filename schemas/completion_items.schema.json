          "question_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "chapter": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "closure": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "OPEN",
              "IN_REVIEW",
              "ANSWERED",
              "RESOLVED",
              "CLOSED",
              "DEFERRED",
              "NOT_APPLICABLE"
            ]
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "approver": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision_record": {
            "type": [
              "string",
              "null"
            ]
          },
          "section_anchor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "question_anchor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "question_id",
          "chapter",
          "note",
          "title",
          "question",
          "closure",
          "status",
          "answer",
          "owner",
          "due_date",
          "approver",
          "decision_record",
          "section_anchor",
          "question_anchor"
