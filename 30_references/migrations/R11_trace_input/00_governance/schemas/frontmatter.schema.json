{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "spkgw.governance-note/v1"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,100}$"
    },
    "project": {
      "const": "SPK-GW_HEMS"
    },
    "document_type": {
      "enum": [
        "STANDARD",
        "MOC",
        "TEMPLATE",
        "TASK",
        "PLAN",
        "RISK",
        "CHANGE",
        "DECISION",
        "REPORT",
        "RUN",
        "BUDGET",
        "EVIDENCE",
        "MEETING",
        "RESEARCH",
        "TRACE_PLAN",
        "DESIGN"
      ]
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "DRAFT_FOR_REVIEW",
        "IN_REVIEW",
        "APPROVED",
        "SUPERSEDED",
        "WITHDRAWN",
        "TEMPLATE",
        "GENERATED"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,100}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,100}$"
    },
    "created_on": {
      "type": "string",
      "format": "date"
    },
    "updated_on": {
      "type": "string",
      "format": "date"
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "source_baseline": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,100}$"
      },
      "uniqueItems": true
    },
    "trace_contract": {
      "const": "spkgw.lifecycle-tags/v1"
    },
    "related_trace_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TRC-[A-Za-z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "phase_ids": {
      "type": "array",
      "items": {
        "enum": [
          "P01",
          "P02",
          "P03",
          "P04",
          "P05",
          "P06",
          "P07",
          "P08",
          "P09",
          "P10",
          "P11",
          "P12",
          "P13",
          "P14",
          "P15",
          "P16",
          "P17"
        ]
      },
      "uniqueItems": true
    },
    "phase_scope": {
      "enum": [
        "PHASE_SPECIFIC",
        "CROSS_PHASE",
        "UNASSIGNED"
      ]
    },
    "activity_type": {
      "enum": [
        "ENGINEERING",
        "RESEARCH",
        "MEETING",
        "REVIEW",
        "PROJECT_MANAGEMENT",
        "PROCUREMENT",
        "REWORK",
        "PROCESS_IMPROVEMENT",
        "UNSPECIFIED"
      ]
    }
  },
  "required": [
    "schema",
    "document_id",
    "project",
    "document_type",
    "revision",
    "status",
    "title",
    "owner",
    "trace_id",
    "created_on",
    "updated_on",
    "classification",
    "source_baseline",
    "related_ids"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": [
          "trace_contract"
        ]
      },
      "then": {
        "required": [
          "related_trace_ids",
          "phase_ids",
          "phase_scope",
          "activity_type"
        ]
      }
    }
  ]
}
