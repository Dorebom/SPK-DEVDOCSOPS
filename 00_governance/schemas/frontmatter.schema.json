{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "spkgw.governance-note/v1"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,100}$"
    },
    "project": {
      "const": "SPK-GW_HEMS"
    },
    "document_type": {
      "enum": [
        "STANDARD",
        "MOC",
        "TEMPLATE",
        "TASK",
        "PLAN",
        "RISK",
        "CHANGE",
        "DECISION",
        "REPORT",
        "RUN",
        "BUDGET",
        "EVIDENCE",
        "MEETING",
        "RESEARCH",
        "TRACE_PLAN",
        "DESIGN"
      ]
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "DRAFT_FOR_REVIEW",
        "IN_REVIEW",
        "APPROVED",
        "SUPERSEDED",
        "WITHDRAWN",
        "TEMPLATE",
        "GENERATED"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,100}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,100}$"
    },
    "created_on": {
      "type": "string",
      "format": "date"
    },
    "updated_on": {
      "type": "string",
      "format": "date"
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "source_baseline": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,100}$"
      },
      "uniqueItems": true
    },
    "trace_contract": {
      "enum": [
        "spkgw.lifecycle-tags/v1",
        "spkgw.lifecycle-tags/v2"
      ]
    },
    "related_trace_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(TRC|THR)-[A-Za-z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "phase_ids": {
      "type": "array",
      "items": {
        "enum": [
          "CONCEPT",
          "REQAN",
          "REQSPEC",
          "SYSDES",
          "ARCH",
          "BASIC",
          "DETAIL",
          "IMPL",
          "UT",
          "IT",
          "ST",
          "NFT",
          "VALID",
          "RELPREP",
          "RELEASE",
          "OPS",
          "IMPROVE"
        ]
      },
      "uniqueItems": true
    },
    "phase_scope": {
      "enum": [
        "PHASE_SPECIFIC",
        "CROSS_PHASE",
        "UNASSIGNED"
      ]
    },
    "activity_type": {
      "enum": [
        "ENGINEERING",
        "RESEARCH",
        "MEETING",
        "REVIEW",
        "PROJECT_MANAGEMENT",
        "PROCUREMENT",
        "REWORK",
        "PROCESS_IMPROVEMENT",
        "UNSPECIFIED"
      ]
    },
    "thread_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^THR-SPKGW-[A-Z][A-Z0-9]*-[0-9]{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "related_thread_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^THR-SPKGW-[A-Z][A-Z0-9]*-[0-9]{6}$"
      },
      "uniqueItems": true
    },
    "document_trace_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^DTR-SPKGW-[A-Z][A-Z0-9]*-[0-9]{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "item_trace_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ITR-SPKGW-[A-Z][A-Z0-9]*-[0-9]{6}$"
      },
      "uniqueItems": true
    },
    "legacy_phase": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "document_id",
    "project",
    "document_type",
    "revision",
    "status",
    "title",
    "owner",
    "created_on",
    "updated_on",
    "classification",
    "source_baseline",
    "related_ids"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "trace_id"
          ],
          "not": {
            "required": [
              "thread_id"
            ]
          }
        },
        {
          "required": [
            "thread_id"
          ],
          "not": {
            "required": [
              "trace_id"
            ]
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "trace_contract": {
            "const": "spkgw.lifecycle-tags/v2"
          }
        },
        "required": [
          "trace_contract"
        ]
      },
      "then": {
        "required": [
          "thread_id",
          "related_thread_ids",
          "document_trace_id",
          "item_trace_ids",
          "phase_ids",
          "phase_scope",
          "activity_type"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "trace_contract": {
            "const": "spkgw.lifecycle-tags/v1"
          }
        },
        "required": [
          "trace_contract"
        ]
      },
      "then": {
        "required": [
          "related_trace_ids",
          "phase_ids",
          "phase_scope",
          "activity_type"
        ]
      }
    }
  ]
}
